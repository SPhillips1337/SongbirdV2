# API Keys
PERPLEXITY_API_KEY=your_perplexity_key_here
LIGHTRAG_API_KEY=your_lightrag_key_here

# Service URLs
COMFYUI_URL=http://your-comfy-ip:8188
COMFYUI_VERIFY_SSL=true # Set to false if using a remote server with self-signed or tunnel certificates
LIGHTRAG_URL=http://your-lightrag-ip:9621
PERPLEXICA_URL=http://your-perplexica-ip:3030
# Seconds before giving up on local Perplexica (default 20). Keep low if host is often offline.
PERPLEXICA_TIMEOUT=20
OLLAMA_BASE_URL=http://your-ollama-ip:11434
# Set to openai for an OpenAI-compatible server such as LM Studio; auto detects :1234.
LLM_API_MODE=auto
PERPLEXICA_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M
PERPLEXICA_EMBEDDING_MODEL=nomic-embed-text:latest
PERPLEXICA_OPTIMIZATION_MODE=speed

# Database Config (PostgreSQL/PGVector)
POSTGRES_HOST=your-postgres-ip
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# Models
ARTIST_MODEL=qwen3:14b
MUSIC_MODEL=qwen3:14b
LYRIC_MODEL=qwen3:14b
ALBUM_MODEL=qwen3:14b
